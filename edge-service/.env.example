FIELDNOTE_DATA_DIR=../runtime
FIELDNOTE_SEED_DIR=../seed-data
EDGE_COLLECTION=fieldnote_memory
EDGE_VECTOR_SIZE=384
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=google/embeddinggemma-300m
REASONING_BACKEND=deterministic
REASONING_MODEL=google/gemma-4-E2B-it
# Optional online summarizer. Set REASONING_BACKEND=gemini-api only after
# creating a separate Gemini API key; never put this key in the React app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CENTRAL_QDRANT_URL=
CENTRAL_QDRANT_API_KEY=
CENTRAL_QDRANT_COLLECTION=fieldnote_shared
ALLOW_DEMO_CENTRAL=true

# After running model-download.ps1 and accepting the Google model licenses,
# use the local model profile below. Gemma 4 E2B is loaded through the official
# Transformers AutoProcessor + AutoModelForMultimodalLM path. EmbeddingGemma
# emits 768 dimensions, so the Edge service automatically creates a separate
# 768d shard.
# EMBEDDING_BACKEND=embeddinggemma
# EDGE_VECTOR_SIZE=768
# REASONING_BACKEND=gemma4-local
